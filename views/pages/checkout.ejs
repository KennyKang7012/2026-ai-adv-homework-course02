<div id="app">

  <!-- Nav step indicator overlay in page header -->
  <div style="background:#1A1A1A; padding:0 80px;">
    <div style="max-width:1280px; margin:0 auto; display:flex; justify-content:center; align-items:center; gap:10px; padding:16px 0; border-bottom:1px solid rgba(255,255,255,.08);">
      <div v-for="(step, i) in [{n:'01',l:'購物車'},{n:'02',l:'填寫資料'},{n:'03',l:'確認訂單'}]" :key="i"
           style="display:flex; align-items:center; gap:8px;">
        <div :style="i === 1
               ? 'background:#FF4FB6; width:24px; height:24px; border-radius:50%; display:flex; align-items:center; justify-content:center;'
               : 'background:#333; width:24px; height:24px; border-radius:50%; display:flex; align-items:center; justify-content:center;'">
          <span class="font-ui" style="font-size:10px; color:#fff; letter-spacing:.05em;">{{ step.n }}</span>
        </div>
        <span class="font-ui" :style="i === 1 ? 'font-size:12px; color:#FF4FB6; letter-spacing:.08em;' : 'font-size:12px; color:rgba(255,255,255,.4); letter-spacing:.08em;'">
          {{ step.l }}
        </span>
        <span v-if="i < 2" class="font-ui" style="font-size:12px; color:rgba(255,255,255,.25); margin-left:2px;">→</span>
      </div>
    </div>
  </div>

  <!-- Page heading -->
  <div style="border-bottom:1px solid #E5E7EB; padding:36px 80px 24px;">
    <span class="eyebrow" style="margin-bottom:12px;">CHECKOUT</span>
    <h1 class="font-display" style="font-size:44px; font-weight:700; color:#1A1A1A; line-height:1;">填寫收件資訊</h1>
  </div>

  <div v-if="loading" style="display:flex; justify-content:center; padding:80px 0;">
    <div class="spinner"></div>
  </div>

  <div v-else style="display:flex; min-height:calc(100vh - 300px);">

    <!-- Form column -->
    <div style="flex:1; padding:48px 80px;">
      <div style="max-width:600px;">

        <div style="border:1px solid #E5E7EB; padding:36px; margin-bottom:28px;">
          <h2 class="font-display" style="font-size:20px; font-weight:700; color:#1A1A1A; margin-bottom:24px;">收件人資訊</h2>

          <div style="display:flex; flex-direction:column; gap:20px;">
            <div>
              <label class="form-label">收件人姓名</label>
              <input v-model="form.recipientName" type="text" placeholder="請輸入收件人姓名"
                     class="form-input" :class="{ 'is-error': errors.recipientName }">
              <p v-if="errors.recipientName" class="form-error">{{ errors.recipientName }}</p>
            </div>
            <div>
              <label class="form-label">電子郵件</label>
              <input v-model="form.recipientEmail" type="email" placeholder="請輸入 Email"
                     class="form-input" :class="{ 'is-error': errors.recipientEmail }">
              <p v-if="errors.recipientEmail" class="form-error">{{ errors.recipientEmail }}</p>
            </div>
            <div>
              <label class="form-label">收件地址</label>
              <input v-model="form.recipientAddress" type="text" placeholder="請輸入收件地址"
                     class="form-input" :class="{ 'is-error': errors.recipientAddress }">
              <p v-if="errors.recipientAddress" class="form-error">{{ errors.recipientAddress }}</p>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Summary sidebar -->
    <div style="width:420px; flex-shrink:0; padding:48px 48px; background:#F9F9F9; border-left:1px solid #E5E7EB;">
      <span class="eyebrow" style="margin-bottom:12px;">ORDER SUMMARY</span>
      <div style="display:flex; justify-content:space-between; align-items:center; padding:12px 0; border-bottom:1px solid #E5E7EB; margin-bottom:4px;">
        <h2 class="font-display" style="font-size:20px; font-weight:700; color:#1A1A1A;">訂單摘要</h2>
        <button @click="$router.back ? $router.back() : window.history.back()"
                class="font-ui" style="font-size:11px; color:#FF4FB6; letter-spacing:.08em; background:none; border:none; cursor:pointer;">
          修改
        </button>
      </div>

      <div style="padding:4px 0 8px;">
        <div v-for="item in cartItems" :key="item.id"
             style="display:flex; justify-content:space-between; padding:10px 0; border-bottom:1px solid #E5E7EB;">
          <span class="font-body" style="font-size:13px; color:#4B5563;">{{ item.product.name }} × {{ item.quantity }}</span>
          <span class="font-body" style="font-size:13px; color:#1A1A1A;">NT$ {{ (item.product.price * item.quantity).toLocaleString() }}</span>
        </div>
      </div>

      <div style="padding:8px 0;">
        <div style="display:flex; justify-content:space-between; padding:8px 0;">
          <span class="font-body" style="font-size:13px; color:#4B5563;">商品小計</span>
          <span class="font-body" style="font-size:13px; color:#1A1A1A;">NT$ {{ cartTotal.toLocaleString() }}</span>
        </div>
        <div style="display:flex; justify-content:space-between; padding:8px 0;">
          <span class="font-body" style="font-size:13px; color:#4B5563;">運費</span>
          <span class="font-body" style="font-size:13px; color:#1A1A1A;">{{ cartTotal >= 500 ? '免運' : 'NT$ 150' }}</span>
        </div>
      </div>

      <div style="border-top:1px solid #E5E7EB; padding:20px 0 24px; display:flex; justify-content:space-between; align-items:center;">
        <span class="font-ui" style="font-size:12px; font-weight:700; color:#1A1A1A; letter-spacing:.12em; text-transform:uppercase;">總計</span>
        <span class="font-display" style="font-size:24px; font-weight:700; color:#FF4FB6;">
          NT$ {{ (cartTotal + (cartTotal >= 500 ? 0 : 150)).toLocaleString() }}
        </span>
      </div>

      <button @click="submitOrder" :disabled="submitting" class="btn-accent"
              style="width:100%; font-size:13px; padding:16px 0; justify-content:center; margin-bottom:16px;">
        {{ submitting ? '處理中...' : '確認送出訂單' }}
      </button>

      <div style="display:flex; align-items:center; justify-content:center; gap:6px;">
        <span style="font-size:13px;">🔒</span>
        <span class="font-ui" style="font-size:11px; color:#9CA3AF; letter-spacing:.08em;">安全加密結帳</span>
      </div>
    </div>
  </div>

</div>
