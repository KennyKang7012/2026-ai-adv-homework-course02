<div id="app">

  <div style="border-bottom:1px solid #E5E7EB; padding:40px 80px 28px;">
    <span class="eyebrow" style="margin-bottom:12px;">ACCOUNT</span>
    <h1 class="font-display" style="font-size:44px; font-weight:700; color:#1A1A1A; line-height:1;">帳戶設定</h1>
  </div>

  <div style="display:flex; min-height:calc(100vh - 280px);">

    <!-- Sidebar -->
    <div style="width:260px; flex-shrink:0; background:#F9F9F9; border-right:1px solid #E5E7EB; display:flex; flex-direction:column;">
      <div style="display:flex; align-items:center; gap:16px; padding:32px 24px;">
        <div style="width:48px; height:48px; border-radius:50%; background:#FF4FB6; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
          <span class="font-display" style="font-size:18px; font-weight:700; color:#fff;">{{ userInitial }}</span>
        </div>
        <div>
          <p class="font-display" style="font-size:15px; font-weight:700; color:#1A1A1A;">{{ userName }}</p>
          <p class="font-ui" style="font-size:11px; color:#9CA3AF; letter-spacing:.04em;">{{ userEmail }}</p>
        </div>
      </div>
      <a href="/orders" style="display:flex; align-items:center; gap:12px; padding:14px 24px; text-decoration:none; border-left:3px solid transparent; background:#F9F9F9;" class="font-ui" onmouseover="this.style.background='#fff'" onmouseout="this.style.background='#F9F9F9'">
        <span style="font-size:13px; color:#4B5563; letter-spacing:.08em;">我的訂單</span>
      </a>
      <a href="/account" style="display:flex; align-items:center; gap:12px; padding:14px 24px; text-decoration:none; border-left:3px solid #FF4FB6; background:#fff;" class="font-ui">
        <span style="font-size:13px; font-weight:700; color:#FF4FB6; letter-spacing:.08em;">帳戶設定</span>
      </a>
      <a href="/address" style="display:flex; align-items:center; gap:12px; padding:14px 24px; text-decoration:none; border-left:3px solid transparent; background:#F9F9F9;" class="font-ui" onmouseover="this.style.background='#fff'" onmouseout="this.style.background='#F9F9F9'">
        <span style="font-size:13px; color:#4B5563; letter-spacing:.08em;">收件地址</span>
      </a>
      <div style="height:1px; background:#E5E7EB; margin:8px 24px;"></div>
      <button onclick="Auth.logout()" class="font-ui" style="width:100%; text-align:left; padding:14px 24px; background:none; border:none; cursor:pointer; font-size:13px; color:#9CA3AF; letter-spacing:.08em;" onmouseover="this.style.color='#EF4444'" onmouseout="this.style.color='#9CA3AF'">登出</button>
    </div>

    <!-- Main -->
    <div style="flex:1; padding:40px 48px; display:flex; flex-direction:column; gap:28px;">

      <div style="display:flex; justify-content:space-between; align-items:center; padding-bottom:20px; border-bottom:1px solid #E5E7EB;">
        <h2 class="font-display" style="font-size:22px; font-weight:700; color:#1A1A1A;">帳戶資訊</h2>
      </div>

      <!-- 基本資訊 -->
      <div style="border:1px solid #E5E7EB; border-radius:4px; overflow:hidden;">
        <div style="padding:20px 24px; border-bottom:1px solid #E5E7EB; background:#F9F9F9;">
          <h3 class="font-display" style="font-size:16px; font-weight:700; color:#1A1A1A;">基本資訊</h3>
        </div>
        <div style="padding:28px 24px; display:flex; flex-direction:column; gap:20px;">
          <div>
            <label class="form-label">姓名</label>
            <input v-model="form.name" type="text" placeholder="請輸入姓名" class="form-input">
          </div>
          <div>
            <label class="form-label">電子郵件</label>
            <input v-model="form.email" type="email" placeholder="請輸入 Email" class="form-input" disabled style="opacity:.6; cursor:not-allowed;">
            <p class="font-ui" style="font-size:11px; color:#9CA3AF; margin-top:4px; letter-spacing:.04em;">Email 不可修改</p>
          </div>
        </div>
      </div>

      <!-- 修改密碼 -->
      <div style="border:1px solid #E5E7EB; border-radius:4px; overflow:hidden;">
        <div style="padding:20px 24px; border-bottom:1px solid #E5E7EB; background:#F9F9F9;">
          <h3 class="font-display" style="font-size:16px; font-weight:700; color:#1A1A1A;">修改密碼</h3>
        </div>
        <div style="padding:28px 24px; display:flex; flex-direction:column; gap:20px;">
          <div>
            <label class="form-label">現有密碼</label>
            <input v-model="form.currentPassword" type="password" placeholder="輸入現有密碼" class="form-input">
          </div>
          <div>
            <label class="form-label">新密碼</label>
            <input v-model="form.newPassword" type="password" placeholder="輸入新密碼" class="form-input">
          </div>
          <div>
            <label class="form-label">確認新密碼</label>
            <input v-model="form.confirmPassword" type="password" placeholder="再次輸入新密碼" class="form-input">
          </div>
        </div>
      </div>

      <div>
        <button @click="save" :disabled="saving" class="btn-accent" style="font-size:13px; padding:14px 36px;">
          {{ saving ? '儲存中...' : '儲存設定' }}
        </button>
      </div>

    </div>
  </div>

</div>
