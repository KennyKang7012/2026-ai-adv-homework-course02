<div id="app" data-order-id="<%= orderId %>" data-payment-result="<%= paymentResult %>">

  <div v-if="loading" style="display:flex; justify-content:center; padding:80px 0;">
    <div class="spinner"></div>
  </div>

  <template v-else-if="order">

    <!-- Payment result alert -->
    <div v-if="paymentResult && paymentMessages[paymentResult]"
         style="padding:14px 80px;"
         :class="paymentMessages[paymentResult].cls">
      <span class="font-ui" style="font-size:13px; letter-spacing:.06em;">{{ paymentMessages[paymentResult].text }}</span>
    </div>

    <!-- Page header -->
    <div style="border-bottom:1px solid #E5E7EB; padding:40px 80px 28px; display:flex; align-items:flex-end; justify-content:space-between;">
      <div>
        <span class="eyebrow" style="margin-bottom:12px;">ORDER DETAIL</span>
        <h1 class="font-display" style="font-size:44px; font-weight:700; color:#1A1A1A; line-height:1; margin-bottom:8px;">訂單詳情</h1>
        <p class="font-body" style="font-size:14px; color:#9CA3AF;">
          {{ order.order_no }}&nbsp;&nbsp;·&nbsp;&nbsp;{{ new Date(order.created_at).toLocaleDateString('zh-TW') }}
        </p>
      </div>
      <span class="status-badge"
            :class="{
              'status-pending':   order.status === 'pending',
              'status-shipped':   order.status === 'shipped',
              'status-completed': order.status === 'completed',
              'status-cancelled': order.status === 'cancelled'
            }"
            style="font-size:12px; padding:6px 18px;">
        {{ statusMap[order.status]?.label || order.status }}
      </span>
    </div>

    <div style="display:flex; min-height:calc(100vh - 300px);">

      <!-- Left: items + actions -->
      <div style="flex:1; padding:40px 80px; display:flex; flex-direction:column; gap:28px;">

        <!-- Items table -->
        <div style="border:1px solid #E5E7EB; overflow:hidden;">

          <!-- Table header -->
          <div style="display:flex; justify-content:space-between; align-items:center; padding:18px 24px; background:#F9F9F9; border-bottom:1px solid #E5E7EB;">
            <h2 class="font-display" style="font-size:18px; font-weight:700; color:#1A1A1A;">商品明細</h2>
            <span class="font-body" style="font-size:13px; color:#9CA3AF; font-style:italic;">{{ order.items.length }} 件商品</span>
          </div>

          <!-- Col headers -->
          <div class="font-ui" style="display:grid; grid-template-columns:1fr 140px 100px 130px; padding:10px 24px; background:#F9F9F9; border-bottom:1px solid #E5E7EB; font-size:10px; color:#9CA3AF; letter-spacing:.2em; text-transform:uppercase;">
            <span>商品名稱</span>
            <span style="text-align:right;">單價</span>
            <span style="text-align:center;">數量</span>
            <span style="text-align:right;">小計</span>
          </div>

          <!-- Items -->
          <div v-for="item in order.items" :key="item.id"
               style="display:grid; grid-template-columns:1fr 140px 100px 130px; align-items:center; padding:16px 24px; border-bottom:1px solid #E5E7EB;">
            <p class="font-display" style="font-size:14px; font-weight:700; color:#1A1A1A;">{{ item.product_name }}</p>
            <p class="font-body" style="font-size:13px; color:#4B5563; text-align:right;">NT$ {{ item.product_price.toLocaleString() }}</p>
            <p class="font-body" style="font-size:13px; color:#4B5563; text-align:center;">{{ item.quantity }}</p>
            <p class="font-body" style="font-size:14px; color:#1A1A1A; text-align:right; font-weight:500;">
              NT$ {{ (item.product_price * item.quantity).toLocaleString() }}
            </p>
          </div>

          <!-- Subtotal + Total row -->
          <div style="display:flex; align-items:center; justify-content:flex-end; gap:32px; padding:14px 24px; border-top:1px solid #E5E7EB;">
            <span class="font-body" style="font-size:13px; color:#4B5563;">商品小計</span>
            <span class="font-body" style="font-size:14px; color:#4B5563;">
              NT$ {{ order.items.reduce((s,i)=>s+i.product_price*i.quantity,0).toLocaleString() }}
            </span>
          </div>
          <div style="display:flex; align-items:center; justify-content:flex-end; gap:32px; padding:14px 24px; border-top:1px solid #E5E7EB;">
            <span class="font-ui" style="font-size:12px; font-weight:700; color:#1A1A1A; letter-spacing:.12em;">總計</span>
            <span class="font-display" style="font-size:22px; font-weight:700; color:#FF4FB6;">
              NT$ {{ order.total_amount.toLocaleString() }}
            </span>
          </div>
        </div>

        <!-- Payment actions (only when pending) -->
        <div v-if="order.status === 'pending'" style="display:flex; gap:16px; align-items:center;">
          <button @click="checkPayment" :disabled="paying" class="btn-outline" style="font-size:12px; padding:12px 24px;">
            {{ paying ? '查詢中...' : '查詢付款狀態' }}
          </button>
          <a :href="'/ecpay/payment/' + order.id" class="btn-accent" style="font-size:12px; padding:13px 28px;">
            前往付款
          </a>
        </div>

      </div>

      <!-- Right: info cards -->
      <div style="width:340px; flex-shrink:0; padding:40px 40px; background:#F9F9F9; border-left:1px solid #E5E7EB; display:flex; flex-direction:column; gap:20px;">

        <!-- Order info -->
        <div style="border:1px solid #E5E7EB; background:#fff; overflow:hidden;">
          <div style="padding:14px 18px; border-bottom:1px solid #E5E7EB;">
            <h3 class="font-display" style="font-size:15px; font-weight:700; color:#1A1A1A;">訂單資訊</h3>
          </div>
          <div v-for="row in [{l:'訂單編號',v:order.order_no},{l:'建立日期',v:new Date(order.created_at).toLocaleDateString('zh-TW')},{l:'付款方式',v:order.payment_method||'—'},{l:'訂單狀態',v:statusMap[order.status]?.label||order.status}]" :key="row.l"
               style="display:flex; justify-content:space-between; align-items:center; padding:11px 18px; border-bottom:1px solid #E5E7EB;">
            <span class="font-ui" style="font-size:11px; color:#9CA3AF; letter-spacing:.08em; text-transform:uppercase;">{{ row.l }}</span>
            <span class="font-body" style="font-size:13px; color:#1A1A1A;">{{ row.v }}</span>
          </div>
        </div>

        <!-- Recipient info -->
        <div style="border:1px solid #E5E7EB; background:#fff; overflow:hidden;">
          <div style="padding:14px 18px; border-bottom:1px solid #E5E7EB;">
            <h3 class="font-display" style="font-size:15px; font-weight:700; color:#1A1A1A;">收件資訊</h3>
          </div>
          <div style="padding:14px 18px; display:flex; flex-direction:column; gap:12px;">
            <div>
              <p class="font-ui" style="font-size:10px; color:#9CA3AF; letter-spacing:.15em; text-transform:uppercase; margin-bottom:4px;">收件人</p>
              <p class="font-body" style="font-size:13px; color:#1A1A1A;">{{ order.recipient_name }}</p>
            </div>
            <div>
              <p class="font-ui" style="font-size:10px; color:#9CA3AF; letter-spacing:.15em; text-transform:uppercase; margin-bottom:4px;">Email</p>
              <p class="font-body" style="font-size:13px; color:#1A1A1A;">{{ order.recipient_email }}</p>
            </div>
            <div>
              <p class="font-ui" style="font-size:10px; color:#9CA3AF; letter-spacing:.15em; text-transform:uppercase; margin-bottom:4px;">地址</p>
              <p class="font-body" style="font-size:13px; color:#1A1A1A; line-height:1.6;">{{ order.recipient_address }}</p>
            </div>
          </div>
        </div>

        <!-- Back link -->
        <a href="/orders" style="display:flex; align-items:center; gap:8px; text-decoration:none;">
          <span class="font-ui" style="font-size:13px; color:#FF4FB6;">←</span>
          <span class="font-ui" style="font-size:12px; color:#FF4FB6; letter-spacing:.08em;">返回訂單列表</span>
        </a>

      </div>
    </div>

  </template>

</div>
