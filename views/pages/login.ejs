<div id="app" style="min-height:calc(100vh - 72px); position:relative; overflow:hidden; background:#1A1A1A;">

  <!-- Background image -->
  <img src="https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=1440&q=80"
       alt="" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:.3;">
  <div style="position:absolute; inset:0; background:linear-gradient(105deg, rgba(0,0,0,.9) 0%, rgba(0,0,0,.6) 60%, rgba(0,0,0,.3) 100%);"></div>

  <!-- Content -->
  <div style="position:relative; z-index:1; display:flex; align-items:flex-start; justify-content:space-between; min-height:inherit; padding:60px 80px;">

    <!-- Login card -->
    <div style="width:420px; background:#fff; border-radius:4px; overflow:hidden; flex-shrink:0;">

      <!-- Card header -->
      <div style="padding:36px 36px 24px; text-align:center; border-bottom:1px solid #E5E7EB;">
        <h1 class="font-display" style="font-size:28px; font-weight:700; font-style:italic; color:#1A1A1A; margin-bottom:8px;">花漾生活</h1>
        <p class="font-body" style="font-size:13px; color:#4B5563;">歡迎回來，請登入您的帳戶</p>
      </div>

      <!-- Tabs -->
      <div style="display:flex; height:46px;">
        <button @click="activeTab = 'login'; errors = {}"
                class="font-ui"
                style="flex:1; font-size:12px; letter-spacing:.12em; text-transform:uppercase; border:none; cursor:pointer; transition:all .2s; border-bottom:2px solid transparent;"
                :style="activeTab === 'login'
                  ? 'background:#FF4FB6; color:#fff; border-bottom-color:#FF4FB6;'
                  : 'background:#F9F9F9; color:#9CA3AF;'">
          登入
        </button>
        <button @click="activeTab = 'register'; errors = {}"
                class="font-ui"
                style="flex:1; font-size:12px; letter-spacing:.12em; text-transform:uppercase; border:none; cursor:pointer; transition:all .2s;"
                :style="activeTab !== 'login'
                  ? 'background:#FF4FB6; color:#fff;'
                  : 'background:#F9F9F9; color:#9CA3AF;'">
          註冊
        </button>
      </div>

      <!-- Login form -->
      <form v-if="activeTab === 'login'" @submit.prevent="handleLogin" style="padding:28px 36px 36px;">
        <div style="display:flex; flex-direction:column; gap:18px;">
          <div>
            <label class="form-label">電子郵件</label>
            <input v-model="loginForm.email" type="email" placeholder="請輸入 Email"
                   class="form-input" :class="{ 'is-error': errors.email }">
            <p v-if="errors.email" class="form-error">{{ errors.email }}</p>
          </div>
          <div>
            <label class="form-label">密碼</label>
            <input v-model="loginForm.password" type="password" placeholder="請輸入密碼"
                   class="form-input" :class="{ 'is-error': errors.password }">
            <p v-if="errors.password" class="form-error">{{ errors.password }}</p>
          </div>
        </div>

        <div style="display:flex; justify-content:flex-end; margin-top:8px; margin-bottom:20px;">
          <span class="font-ui" style="font-size:11px; color:#FF4FB6; letter-spacing:.08em; cursor:pointer;">忘記密碼？</span>
        </div>

        <button type="submit" :disabled="submitting" class="btn-dark"
                style="width:100%; padding:15px 0; font-size:13px; justify-content:center; margin-bottom:20px;">
          {{ submitting ? '登入中...' : '登入' }}
        </button>

        <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
          <div style="flex:1; height:1px; background:#E5E7EB;"></div>
          <span class="font-body" style="font-size:12px; color:#9CA3AF;">或</span>
          <div style="flex:1; height:1px; background:#E5E7EB;"></div>
        </div>

        <button type="button" class="btn-outline" style="width:100%; font-size:12px; padding:12px 0; justify-content:center;">
          以訪客身份繼續
        </button>
      </form>

      <!-- Register form -->
      <form v-else @submit.prevent="handleRegister" style="padding:28px 36px 36px;">
        <div style="display:flex; flex-direction:column; gap:18px;">
          <div>
            <label class="form-label">姓名</label>
            <input v-model="registerForm.name" type="text" placeholder="請輸入姓名"
                   class="form-input" :class="{ 'is-error': errors.name }">
            <p v-if="errors.name" class="form-error">{{ errors.name }}</p>
          </div>
          <div>
            <label class="form-label">電子郵件</label>
            <input v-model="registerForm.email" type="email" placeholder="請輸入 Email"
                   class="form-input" :class="{ 'is-error': errors.email }">
            <p v-if="errors.email" class="form-error">{{ errors.email }}</p>
          </div>
          <div>
            <label class="form-label">密碼</label>
            <input v-model="registerForm.password" type="password" placeholder="至少 6 個字元"
                   class="form-input" :class="{ 'is-error': errors.password }">
            <p v-if="errors.password" class="form-error">{{ errors.password }}</p>
          </div>
        </div>
        <button type="submit" :disabled="submitting" class="btn-accent"
                style="width:100%; padding:15px 0; font-size:13px; justify-content:center; margin-top:24px;">
          {{ submitting ? '註冊中...' : '建立帳戶' }}
        </button>
      </form>
    </div>

    <!-- Right quote (decorative) -->
    <div style="padding-top:80px; max-width:340px;">
      <p class="font-display" style="font-size:34px; font-weight:700; color:#fff; line-height:1.28; margin-bottom:16px;">
        「每一朵花，<br>都在等待<br>屬於它的故事。」
      </p>
      <p class="font-body" style="font-size:14px; color:rgba(255,255,255,.45); font-style:italic;">— 花漾生活</p>
    </div>

  </div>
</div>
