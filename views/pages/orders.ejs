<div id="app">

  <!-- Page header -->
  <div style="border-bottom:1px solid #E5E7EB; padding:40px 80px 28px;">
    <span class="eyebrow" style="margin-bottom:12px;">ACCOUNT</span>
    <h1 class="font-display" style="font-size:44px; font-weight:700; color:#1A1A1A; line-height:1;">我的訂單</h1>
  </div>

  <div style="display:flex; min-height:calc(100vh - 280px);">

    <!-- Sidebar -->
    <div style="width:260px; flex-shrink:0; background:#F9F9F9; border-right:1px solid #E5E7EB; display:flex; flex-direction:column;">

      <!-- User info -->
      <div style="display:flex; align-items:center; gap:16px; padding:32px 24px;">
        <div style="width:48px; height:48px; border-radius:50%; background:#FF4FB6; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
          <span class="font-display" style="font-size:18px; font-weight:700; color:#fff;">{{ userInitial }}</span>
        </div>
        <div>
          <p class="font-display" style="font-size:15px; font-weight:700; color:#1A1A1A;">{{ userName }}</p>
          <p class="font-ui" style="font-size:11px; color:#9CA3AF; letter-spacing:.04em;">{{ userEmail }}</p>
        </div>
      </div>

      <!-- Nav items -->
      <a href="/orders"
         style="display:flex; align-items:center; gap:12px; padding:14px 24px; text-decoration:none; border-left:3px solid #FF4FB6; background:#fff;"
         class="font-ui">
        <span style="font-size:13px; font-weight:700; color:#FF4FB6; letter-spacing:.08em;">我的訂單</span>
      </a>
      <a href="/account"
         style="display:flex; align-items:center; gap:12px; padding:14px 24px; text-decoration:none; border-left:3px solid transparent; background:#F9F9F9;"
         class="font-ui" onmouseover="this.style.background='#fff'" onmouseout="this.style.background='#F9F9F9'">
        <span style="font-size:13px; color:#4B5563; letter-spacing:.08em;">帳戶設定</span>
      </a>
      <a href="/address"
         style="display:flex; align-items:center; gap:12px; padding:14px 24px; text-decoration:none; border-left:3px solid transparent; background:#F9F9F9;"
         class="font-ui" onmouseover="this.style.background='#fff'" onmouseout="this.style.background='#F9F9F9'">
        <span style="font-size:13px; color:#4B5563; letter-spacing:.08em;">收件地址</span>
      </a>
      <div style="height:1px; background:#E5E7EB; margin:8px 24px;"></div>
      <button onclick="Auth.logout()"
              class="font-ui"
              style="width:100%; text-align:left; padding:14px 24px; background:none; border:none; cursor:pointer; font-size:13px; color:#9CA3AF; letter-spacing:.08em;"
              onmouseover="this.style.color='#EF4444'" onmouseout="this.style.color='#9CA3AF'">
        登出
      </button>
    </div>

    <!-- Main content -->
    <div style="flex:1; padding:32px 48px;">

      <div v-if="loading" style="display:flex; justify-content:center; padding:60px 0;">
        <div class="spinner"></div>
      </div>

      <div v-else-if="orders.length === 0" style="text-align:center; padding:80px 0;">
        <p style="font-size:44px; margin-bottom:16px;">📦</p>
        <p class="font-body" style="font-size:15px; color:#4B5563; margin-bottom:6px;">尚無訂單</p>
        <p class="font-ui" style="font-size:12px; color:#9CA3AF; margin-bottom:28px;">快去選購喜歡的花束吧！</p>
        <a href="/" class="btn-accent">去逛逛</a>
      </div>

      <div v-else>
        <div style="display:flex; justify-content:space-between; align-items:center; padding-bottom:16px; border-bottom:1px solid #E5E7EB; margin-bottom:4px;">
          <h2 class="font-display" style="font-size:22px; font-weight:700; color:#1A1A1A;">訂單記錄</h2>
          <span class="font-body" style="font-size:13px; color:#9CA3AF; font-style:italic;">共 {{ orders.length }} 筆訂單</span>
        </div>

        <a v-for="order in orders" :key="order.id"
           :href="'/orders/' + order.id"
           style="display:flex; align-items:center; justify-content:space-between; padding:20px 0; border-bottom:1px solid #E5E7EB; text-decoration:none; transition:background .15s;"
           onmouseover="this.style.background='#FAFAFA'; this.style.marginLeft='-16px'; this.style.paddingLeft='16px'; this.style.marginRight='-16px'; this.style.paddingRight='16px';"
           onmouseout="this.style.background='transparent'; this.style.marginLeft='0'; this.style.paddingLeft='0'; this.style.marginRight='0'; this.style.paddingRight='0';">

          <div>
            <div style="display:flex; align-items:center; gap:12px; margin-bottom:6px;">
              <span class="font-ui" style="font-size:13px; font-weight:700; color:#1A1A1A; letter-spacing:.06em;">{{ order.order_no }}</span>
              <span class="status-badge"
                    :class="{
                      'status-pending':   order.status === 'pending',
                      'status-shipped':   order.status === 'shipped',
                      'status-completed': order.status === 'completed',
                      'status-cancelled': order.status === 'cancelled'
                    }">
                {{ statusMap[order.status]?.label || order.status }}
              </span>
            </div>
            <p class="font-body" style="font-size:12px; color:#9CA3AF; margin-bottom:4px;">
              {{ new Date(order.created_at).toLocaleDateString('zh-TW') }}
            </p>
            <p v-if="order.items_summary" class="font-body" style="font-size:13px; color:#4B5563;">
              {{ order.items_summary }}
            </p>
          </div>

          <div style="display:flex; align-items:center; gap:24px;">
            <span class="font-display" style="font-size:18px; font-weight:700; color:#1A1A1A;">
              NT$ {{ order.total_amount.toLocaleString() }}
            </span>
            <div class="btn-outline" style="font-size:11px; padding:8px 18px;">查看</div>
          </div>
        </a>
      </div>

    </div>
  </div>

</div>
